<?xml version="1.0"?>
<launch>
  <include file="$(find-pkg-share ros_gz_sim)/launch/gz_sim.launch.py">
    <arg name="gz_args"
         value="-s -r $(find-pkg-share warehouse_robot_sim)/worlds/warehouse.sdf"/>
    <arg name="on_exit_shutdown" value="true"/>
  </include>

  <node pkg="ros_gz_sim" exec="create" name="spawn_robot" output="screen"
        args="-world warehouse
              -file $(find-pkg-share warehouse_robot_sim)/urdf/warehouse_robot.urdf
              -name warehouse_robot -z 0.10"/>

  <node pkg="ros_gz_bridge" exec="parameter_bridge" name="gz_bridge" output="screen"
        args="/clock@rosgraph_msgs/msg/Clock[gz.msgs.Clock
              /cmd_vel@geometry_msgs/msg/Twist]gz.msgs.Twist
              /wheel/odom@nav_msgs/msg/Odometry[gz.msgs.Odometry
              /imu/data@sensor_msgs/msg/Imu[gz.msgs.IMU"/>

  <node pkg="warehouse_robot_sim" exec="measurement_covariance.py"
        name="measurement_covariance" output="screen"/>

  <node pkg="robot_localization" exec="ekf_node"
        name="ekf_filter_node" output="screen">
    <param from="$(find-pkg-share warehouse_robot_sim)/config/ekf.yaml"/>
  </node>
</launch>