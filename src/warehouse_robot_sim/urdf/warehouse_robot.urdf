<?xml version="1.0"?>
<robot name="warehouse_robot">
  <link name="base_link">
    <visual name="chassis">
      <origin xyz="-0.04 0 0.05"/>
      <geometry><box size="0.36 0.24 0.10"/></geometry>
    </visual>
    <collision name="chassis">
      <origin xyz="-0.04 0 0.05"/>
      <geometry><box size="0.36 0.24 0.10"/></geometry>
    </collision>
    <visual name="rear_support">
      <origin xyz="-0.15 0 -0.035"/>
      <geometry><sphere radius="0.045"/></geometry>
    </visual>
    <collision name="rear_support">
      <origin xyz="-0.15 0 -0.035"/>
      <geometry><sphere radius="0.045"/></geometry>
    </collision>
    <inertial>
      <origin xyz="-0.04 0 0.05"/>
      <mass value="4.0"/>
      <inertia ixx="0.02253" ixy="0" ixz="0"
               iyy="0.04653" iyz="0" izz="0.06240"/>
    </inertial>
  </link>

  <link name="left_wheel_link">
    <visual>
      <origin rpy="1.57079632679 0 0"/>
      <geometry><cylinder radius="0.08" length="0.04"/></geometry>
    </visual>
    <collision>
      <origin rpy="1.57079632679 0 0"/>
      <geometry><cylinder radius="0.08" length="0.04"/></geometry>
    </collision>
    <inertial>
      <mass value="0.25"/>
      <inertia ixx="0.0004333" ixy="0" ixz="0"
               iyy="0.0008" iyz="0" izz="0.0004333"/>
    </inertial>
  </link>

  <link name="right_wheel_link">
    <visual>
      <origin rpy="1.57079632679 0 0"/>
      <geometry><cylinder radius="0.08" length="0.04"/></geometry>
    </visual>
    <collision>
      <origin rpy="1.57079632679 0 0"/>
      <geometry><cylinder radius="0.08" length="0.04"/></geometry>
    </collision>
    <inertial>
      <mass value="0.25"/>
      <inertia ixx="0.0004333" ixy="0" ixz="0"
               iyy="0.0008" iyz="0" izz="0.0004333"/>
    </inertial>
  </link>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel_link"/>
    <origin xyz="0 0.15 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel_link"/>
    <origin xyz="0 -0.15 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <gazebo reference="base_link">
    <mu1>0.03</mu1>
    <mu2>0.03</mu2>
    <sensor name="imu_sensor" type="imu">
      <pose>0 0 0 0 0 0</pose>
      <always_on>true</always_on>
      <update_rate>50</update_rate>
      <topic>/imu/data</topic>
      <gz_frame_id>base_link</gz_frame_id>
      <imu>
        <angular_velocity>
          <z>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.01</stddev>
            </noise>
          </z>
        </angular_velocity>
      </imu>
    </sensor>
  </gazebo>

  <gazebo>
    <plugin filename="gz-sim-diff-drive-system"
            name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.30</wheel_separation>
      <wheel_radius>0.08</wheel_radius>
      <topic>/cmd_vel</topic>
      <odom_topic>/wheel/odom</odom_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
    </plugin>
  </gazebo>
</robot>